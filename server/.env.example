NODE_ENV=development
HOST=127.0.0.1
PORT=5000
# Required: supply a remediated, approved database URI locally. No default URI.
MONGO_URI=
# Comma-separated exact origins. Empty permits no cross-origin browser access.
CORS_ORIGINS=
# Required for normal startup: independently generated secret of at least 32 random bytes.
JWT_SECRET=
# Used only by npm --prefix server run seed:dev-admin (development only).
DEV_ADMIN_EMAIL=
DEV_ADMIN_FIRST_NAME=
DEV_ADMIN_LAST_NAME=
# Unique password of at least 12 characters. Never committed or logged.
DEV_ADMIN_PASSWORD=
# Optional authentication-email delivery. All SMTP fields are required to enable it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional; SMTP_USER is used when blank. Must be an address authorized by the SMTP provider.
MAIL_FROM=
SMTP_FROM_NAME=ShelfLife AI
# ML inference runtime. The backend spawns a persistent Python worker serving
# JSON-lines inference requests against the frozen Random Forest artifact.
# Point these at the local Python executable and the checked-in worker script.
ML_PYTHON_EXECUTABLE=
ML_WORKER_SCRIPT=ml/src/10_persistent_inference_worker.py
ML_STARTUP_TIMEOUT_MS=10000
ML_INFERENCE_TIMEOUT_MS=5000

# Trusted frontend URL, e.g. http://localhost:8081/ShelfLifeAILogin in development.
# HTTPS required in production. Tokens use a fragment, not a query string.
PASSWORD_RESET_URL=
# Persistent sessions: fixed 30 days; access tokens: 15 minutes.
# Host-only HttpOnly SameSite=Lax cookies require same-site frontend/API hosts.
# Use localhost consistently locally; production cookies require HTTPS.
