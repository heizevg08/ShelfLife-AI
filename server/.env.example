# Local-only server configuration. Render supplies these through its dashboard or render.yaml.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000

# Required server secrets — leave empty in this template.
MONGO_URI=
JWT_SECRET=

# Comma-separated, exact browser origins. No wildcard origins are accepted.
CORS_ORIGINS=http://localhost:8081

# Render sits behind one trusted proxy. Keep false for direct local development.
TRUST_PROXY=false

# Use "none" only for HTTPS deployments where the Vercel client and Render API have
# different sites. Local development should use "lax".
COOKIE_SAME_SITE=lax

# Optional development-only initial account used by `npm --prefix server run seed:dev-admin`.
DEV_ADMIN_EMAIL=
DEV_ADMIN_FIRST_NAME=
DEV_ADMIN_LAST_NAME=
DEV_ADMIN_PASSWORD=

# Optional SMTP delivery for password-reset and email-change messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SMTP_FROM_NAME=ShelfLife AI
PASSWORD_RESET_URL=
