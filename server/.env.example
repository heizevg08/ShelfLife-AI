# Local-only server configuration. Render supplies these through its dashboard or render.yaml.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000

# Required server secrets — leave empty in this template.
MONGO_URI=
# Optional database name override. Defaults to shelflifeai for backward compatibility.
MONGO_DB_NAME=
JWT_SECRET=

# Comma-separated, exact browser origins. No wildcard origins are accepted.
CORS_ORIGINS=http://localhost:8081

# Render sits behind one trusted proxy. Keep false for direct local development.
TRUST_PROXY=false

# Use "none" only for HTTPS deployments where the Vercel client and Render API have
# different sites. Local development should use "lax".
COOKIE_SAME_SITE=lax

# Optional development-only initial account used by `npm --prefix server run seed:dev-admin`.
DEV_ADMIN_EMAIL=
DEV_ADMIN_FIRST_NAME=
DEV_ADMIN_LAST_NAME=
DEV_ADMIN_PASSWORD=

# SMTP delivery is required for account creation, password reset, and email changes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SMTP_FROM_NAME=ShelfLife AI

# ML inference runtime. The backend starts without these; ML endpoints remain unavailable.
ML_PYTHON_EXECUTABLE=
ML_WORKER_SCRIPT=ml/src/10_persistent_inference_worker.py
ML_STARTUP_TIMEOUT_MS=30000
ML_INFERENCE_TIMEOUT_MS=50000

PASSWORD_RESET_URL=
# Optional override; by default the login link uses the first CORS_ORIGINS entry.
ACCOUNT_LOGIN_URL=
