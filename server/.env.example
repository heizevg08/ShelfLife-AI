# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/your_db_name

# Server Port
PORT=5000

# JWT Security Secrets (Use long random strings in real .env)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Resend Mail Configuration
RESEND_API_KEY=
RESEND_FROM=

# Password Reset Redirect URL
PASSWORD_RESET_URL=