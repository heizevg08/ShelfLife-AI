{
  "name": "@shelflifeai/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "test": "npm run build && node --test tests/*.test.cjs",
    "seed:dev-admin": "node --env-file-if-exists=.env --import tsx src/scripts/seed-dev-admin.ts",
    "maintenance:harden": "node --env-file-if-exists=.env --import tsx src/scripts/harden-backend.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  }
}
